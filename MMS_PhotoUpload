def next_available_row(col,worksheet):
    str_list = worksheet.col_values(col)
    return len(str_list)+1 

def ProccessMMS(client,sid,Corral,CurrentTime,TOK,ASID):
    try: 
        photo_url=''
        photo = io.BytesIO()
        BASE_URL = "https://api.twilio.com"
        medias = client.messages(sid).media.list()
        for media in medias:
            media_instance = client.messages(sid).media(media.sid).fetch()
            url = BASE_URL + media_instance.uri
            url = url.replace('.json','')
            Name =  Corral + '_' + sid + '_' + media.sid + '.jpg'
            blob = UpdateBucket(Name)
            r = requests.get(url,auth=HTTPBasicAuth(ASID,TOK),allow_redirects=True,stream=True)
            if r.status_code==200:
                for chunk in r.iter_content(chunk_size=8192): 
                    if chunk: # filter out keep-alive new chunks
                        photo.write(chunk)
                photo = photo.getvalue()
                blob.upload_from_string(photo,content_type='image/jpg')
                blob.make_public()
                photo_url = blob.public_url
        return photo_url
    except Exception as e:
        return str(e)
def UpdateBucket(Name):
    try:
        Google_Key = get_secret("GOOGLE_API_KEY")
        creds = ServiceAccountCredentials.get_access_token(Google_Key)      
        storage_client = storage.Client(credentials=creds,project='My First Project')
        bucket = storage_client.get_bucket('corral_photos')
        blob = bucket.blob(Name,chunk_size=262144)
        return blob

    except Exception as e:
        return str(e)
